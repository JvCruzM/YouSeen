{
  "manifest_version": 3,
  "name": "YouSeen",
  "version": "0.2.0",
  "description": "Oculta vídeos do YouTube já assistidos por completo, para você ver só o que falta assistir de um canal.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouSeen",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
